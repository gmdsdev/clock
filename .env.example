# Copie para .env e preencha. Variáveis VITE_* vão para o bundle do navegador:
# use uma chave pessoal, com limite de gastos, e nunca publique o build.

# Chave da API da OpenAI. Vazia = modo mock (perguntas do banco offline, sem rede).
VITE_OPENAPI_KEY=

# Modelo da Responses API (opcional). Padrão: gpt-5.2
VITE_OPENAI_MODEL=

# "true" para não chamar a API mesmo com chave (testar o fluxo sem gastar tokens).
VITE_MOCK_AI=
